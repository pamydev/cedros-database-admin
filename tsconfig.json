{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "strict": false,
    "resolveJsonModule": true,
    "paths": {
      "@projectTypes/*": ["./types/*"]
    }
  }
}
