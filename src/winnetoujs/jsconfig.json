{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "checkJs": true,
    "resolveJsonModule": true,
    "strict": false,
    "paths": {
      "@libs/*": ["./libs/*"],
      "@strings": ["./src/strings"],
      "@icons": ["./source-code/helpers/icons.helper.ts"],
      "@common": ["./source-code/common/common.wcto"],
      "@screens/*": ["./source-code/screens/*"],
      "@projectScreens/*": ["./source-code/project/*"],
      "@leftMenu": ["./source-code/left-menu/left-menu"],
      "@helpers/*": ["./source-code/helpers/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules/*"],
  "include": ["../../types/*.d.ts", "./**/*.ts", "./**/*.js"]
}
